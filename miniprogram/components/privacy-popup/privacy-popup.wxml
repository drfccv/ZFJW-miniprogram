<view class="privacy-mask" wx:if="{{show}}">
  <view class="privacy-popup">
    <view class="privacy-title">隐私保护提示</view>
    <view class="privacy-content">
      在使用当前小程序服务之前，请仔细阅读
      <text class="privacy-link" bindtap="openContract">{{contractName}}</text>。
      如你同意{{contractName}}，请点击「同意」开始使用。
    </view>
    <view class="privacy-btns">
      <button class="privacy-btn disagree" bindtap="handleDisagree">不同意</button>
      <button
        id="agree-btn"
        class="privacy-btn agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="handleAgree"
      >同意</button>
    </view>
  </view>
</view>
