/* 隐私授权弹窗样式 */
.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-popup {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 32rpx;
  box-sizing: border-box;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 28rpx;
}

.privacy-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.7;
  margin-bottom: 40rpx;
}

.privacy-link {
  color: #1989fa;
}

.privacy-btns {
  display: flex;
  gap: 24rpx;
}

.privacy-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 44rpx;
  padding: 0;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn.disagree {
  background: #f2f3f5;
  color: #666666;
}

.privacy-btn.agree {
  background: #1989fa;
  color: #ffffff;
}
