/* 我的页面样式 - 简约白色扁平化风格 */
.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 用户信息卡片 */
.user-card {
  background: linear-gradient(to bottom right, #007AFF, #5AC8FA);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 122, 255, 0.25);
  position: relative;
  overflow: hidden;
}

.user-card::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
  transform: translate(50%, -50%);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  flex-shrink: 0;
}

.avatar-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
}

.user-info {
  flex: 1;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  color: #ffffff;
}

.user-details {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 8rpx;
}

/* 节标题 */
.section-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #999999;
  margin-bottom: 14rpx;
  padding-left: 8rpx;
}

/* 设置部分（卡片分组） */
.settings-section {
  margin-bottom: 28rpx;
}

.settings-section .setting-item:first-child {
  border-radius: 16rpx 16rpx 0 0;
}

.settings-section .setting-item:last-child {
  border-radius: 0 0 16rpx 16rpx;
}

.setting-item {
  background: #ffffff;
  padding: 28rpx 30rpx;
  display: flex;
  align-items: center;
  transition: background-color 0.2s;
}

.setting-item + .setting-item {
  border-top: 1rpx solid #f2f3f5;
}

.setting-item:active {
  background: #f7f8fa;
}

/* 禁用项 */
.setting-item-disabled .setting-title {
  color: #b8b8b8;
}

.setting-item-disabled:active {
  background: #ffffff;
}

.setting-badge {
  font-size: 20rpx;
  color: #999999;
  background: #f2f3f5;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  flex-shrink: 0;
}

.setting-content {
  flex: 1;
  min-width: 0;
}

.setting-title {
  display: block;
  font-size: 28rpx;
  color: #333333;
}

.setting-desc {
  display: block;
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.setting-arrow {
  color: #c8c9cc;
  font-size: 34rpx;
  font-weight: 300;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.logout-text {
  color: #ff4757 !important;
  font-weight: 600;
}

/* 功能宫格 */
.profile-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 8rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 16rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #f0f0f2;
  transition: all 0.2s;
}

.grid-item:active {
  transform: scale(0.97);
  background: #fafafa;
}

.grid-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.icon-img {
  width: 46rpx;
  height: 46rpx;
}

/* 浅色 tint 底块 + 同色系图标（微信服务宫格风格，低饱和、克制） */
.grid-icon.blue { background: #EDF5FF; }
.grid-icon.green { background: #EAF9F0; }
.grid-icon.orange { background: #FFF4E5; }
.grid-icon.purple { background: #F6EEFF; }
.grid-icon.cyan { background: #E8FBF9; }

.grid-text {
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}

/* 设置项开关 */
.setting-switch {
  flex-shrink: 0;
  margin-left: 12rpx;
  transform: scale(0.9);
}

/* 模态框 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #ffffff;
  border-radius: 24rpx;
  width: 620rpx;
  max-width: 90vw;
  overflow: hidden;
}

.modal-header {
  padding: 36rpx 30rpx 16rpx;
  text-align: center;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.modal-body {
  padding: 16rpx 30rpx 30rpx;
}

.modal-actions {
  display: flex;
  border-top: 1rpx solid #f2f3f5;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border: none;
  background: transparent;
}

.modal-btn.cancel {
  color: #666666;
  border-right: 1rpx solid #f2f3f5;
}

.modal-btn.confirm {
  color: #007AFF;
  font-weight: 600;
}

/* 默认页面选择样式 */
.page-option-list {
  max-height: 480rpx;
  overflow-y: auto;
}

.page-option {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  transition: background 0.2s;
}

.page-option:last-child {
  border-bottom: none;
}

.page-option:active {
  background: #f7f8fa;
}

.page-option-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.page-option-name {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 4rpx;
}

.page-option-desc {
  font-size: 22rpx;
  color: #999999;
}

.page-option-check {
  color: #007AFF;
  font-size: 34rpx;
  font-weight: 600;
  width: 40rpx;
  text-align: center;
}

/* 成绩接口类型选择 */
.api-type-option {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
  display: flex;
  align-items: center;
  transition: background 0.2s;
}

.api-type-option:last-child {
  border-bottom: none;
}

.api-type-option:active {
  background: #f7f8fa;
}

.api-type-content {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.api-type-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 4rpx;
}

.api-type-desc {
  font-size: 22rpx;
  color: #999999;
}

.api-type-check {
  margin-left: auto;
  color: #007AFF;
  font-size: 34rpx;
  font-weight: 600;
  flex-shrink: 0;
}
