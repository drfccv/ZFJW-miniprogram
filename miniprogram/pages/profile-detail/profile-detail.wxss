.container {
  min-height: 100vh;
  background: #f8f9fa;
  padding: 24rpx;
  box-sizing: border-box;
}

.profile-detail-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx 24rpx;
}

.avatar-section {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.avatar-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(to bottom right, #007AFF, #5AC8FA);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 54rpx;
  font-weight: 600;
  color: #ffffff;
}

.name-section {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 8rpx;
}

.sid {
  font-size: 26rpx;
  color: #999999;
}

.info-list {
  margin-top: 8rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}

.info-item + .info-item {
  border-top: 1rpx solid #f2f3f5;
}

.label {
  width: 160rpx;
  color: #999999;
  font-size: 26rpx;
  flex-shrink: 0;
}

.value {
  color: #333333;
  font-size: 26rpx;
  word-break: break-all;
  flex: 1;
} 