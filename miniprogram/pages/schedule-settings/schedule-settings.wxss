/* 课表设置页面样式 - 统一简约风格 */

/* 页面容器 */
.container {
  background-color: #f8f9fa;
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 设置区块 */
.setting-section {
  background: #ffffff;
  margin-bottom: 28rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.section-title {
  padding: 26rpx 30rpx 14rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #999999;
  border-bottom: 1rpx solid #f2f3f5;
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  transition: background-color 0.2s ease;
  min-height: 88rpx;
}

.setting-item + .setting-item {
  border-top: 1rpx solid #f2f3f5;
}

.setting-item:active {
  background-color: #f7f8fa;
}

.setting-label {
  font-size: 28rpx;
  color: #333333;
}

.setting-value {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999999;
}

.arrow {
  margin-left: 12rpx;
  color: #c8c9cc;
  font-size: 30rpx;
}

/* 刷新课表数据 作为设置项 */
.refresh-value {
  color: #999999;
}

/* 说明信息 */
.info-section {
  background: #ffffff;
  margin-top: 8rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.info-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #999999;
  margin-bottom: 20rpx;
}

.info-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.info-text:last-child {
  margin-bottom: 0;
}
