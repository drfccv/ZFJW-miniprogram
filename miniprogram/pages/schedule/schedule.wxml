<!--课表页面-->
<view class="container">
  <!-- 当前周次显示 -->
  <view class="current-week-display">
    <text class="current-week-text">第{{currentWeek}}周课表</text>
    <text class="swipe-hint">左右滑动切换周次</text>
  </view>

  <!-- 课表表格 -->
  <view class="schedule-wrapper" 
        bindtouchstart="onTouchStart" 
        bindtouchend="onTouchEnd">
    <scroll-view class="schedule-container" scroll-y wx:if="{{scheduleData.length > 0}}">    <!-- 表头 -->
    <view class="schedule-header">
      <!-- 时间列头 -->
      <view class="time-column-header">
        <text class="time-header-text">节次</text>
      </view>
      <!-- 日期列头 -->
      <view class="day-header" wx:for="{{dayHeaders}}" wx:key="index">
        <text class="day-name">{{item.name}}</text>
        <text class="day-date">{{item.date}}</text>
      </view>
    </view><!-- 课表内容 -->
    <view class="schedule-body {{animationClass}}">      <view 
        class="schedule-row" 
        style="height: max(calc((100vh - 300rpx) / {{maxPeriods}}), 80rpx);"
        wx:for="{{mergedScheduleGrid}}" 
        wx:key="index" 
        wx:for-item="timeSlot" 
        wx:for-index="periodIndex"
      ><!-- 时间列 -->
        <view class="time-column">
          <text class="time-period">{{periodIndex + 1}}</text>
        </view>
        
        <!-- 课程单元格 -->
        <view class="day-column" wx:for="{{dayHeaders}}" wx:key="dayIndex" wx:for-item="day" wx:for-index="dayIndex">
          <!-- 判断该时间段是否有课程 -->
          <view wx:if="{{timeSlot[dayIndex] && timeSlot[dayIndex].length > 0}}" class="course-cell-container">
            <!-- 遍历该时间段的所有课程（支持冲突课程和占位符） -->
            <view 
              wx:for="{{timeSlot[dayIndex]}}" 
              wx:key="courseIndex" 
              wx:for-item="course" 
              wx:for-index="courseIndex"
            >
              <!-- 显示课程（包括正常课程和冲突课程） -->
              <view 
                wx:if="{{!course.isPlaceholder}}"
                class="course-cell has-course {{course.isMerged ? 'merged-course' : ''}} {{course.isConflict ? 'conflict-course' : ''}} course-color-{{course.colorIndex}}"
                style="{{course.isMerged ? 'height: calc(' + course.periods + ' * max(((100vh - 300rpx) / ' + maxPeriods + '), 80rpx));' : 'height: calc((100vh - 300rpx) / ' + maxPeriods + ');'}}"
                bindtap="showCourseDetail"
                data-course="{{course}}"
              >
                <view class="course-content">
                  <text class="course-name">{{course.title}}</text>
                  <text class="course-location">{{course.place}}</text>
                  <text class="course-teacher">{{course.teacher}}</text>
                  <text wx:if="{{course.isConflict && !course.conflictCourses}}" class="conflict-indicator">冲突</text>
                  
                  <!-- 冲突课程切换按钮 -->
                  <view 
                    wx:if="{{course.conflictCourses && course.conflictCourses.length > 1}}"
                    class="conflict-switch-btn"
                    catchtap="switchConflictCourse"
                    data-period="{{periodIndex}}"
                    data-day="{{dayIndex}}"
                  >
                    <text class="conflict-count">{{course.currentConflictIndex + 1}}/{{course.conflictCourses.length}}</text>
                  </view>
                </view>
              </view>
              
              <!-- 显示占位符 -->
              <view 
                wx:elif="{{course.isPlaceholder}}"
                class="course-cell placeholder-cell"
              >
              </view>
            </view>
          </view>
          
          <!-- 空格子 -->
          <view 
            wx:else
            class="course-cell empty-cell"
          >
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
  
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{scheduleData.length === 0 && !loading}}">
    <image class="empty-icon-img" src="/icons/schedule.svg" mode="aspectFit"/>
    <text class="empty-text">暂无课表数据</text>
    <button class="reload-btn" bindtap="loadSchedule">重新加载</button>
  </view>
  <!-- 加载状态 -->
  <view class="loading-state" wx:if="{{loading}}">
    <image class="loading-icon-img" src="/icons/loading.svg" mode="aspectFit"/>
    <text class="loading-text">加载中...</text>
  </view>

  </view> <!-- 结束 schedule-wrapper -->
</view>

<!-- 课程详情弹窗 -->
<view class="course-detail-modal {{showCourseDetailModal ? 'show' : ''}}" wx:if="{{showCourseDetailModal && courseDetail}}" bindtap="hideCourseDetail">
  <view class="course-detail-content" catchtap="">
    <!-- 头部 -->
    <view class="course-detail-header">
      <view class="drag-handle"></view>
      <view class="header-left">
        <text class="course-detail-title">{{courseDetail.title}}</text>
        <text class="course-detail-subtitle">{{courseDetail.place}}</text>
      </view>
      <view class="header-right">
        <view class="close-btn" bindtap="hideCourseDetail">
          <text class="close-icon">✕</text>
        </view>
      </view>
    </view>

    <!-- 主要信息卡片 -->
    <view class="course-detail-body">
      <view class="info-card">
        <view class="card-header">
          <text class="card-title">基本信息</text>
        </view>
        <view class="info-grid">
          <view class="info-item">
            <text class="info-label">授课教师</text>
            <text class="info-value">{{courseDetail.teacher}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">上课地点</text>
            <text class="info-value">{{courseDetail.place}}</text>
          </view>
        </view>
      </view>

      <!-- 时间信息卡片 -->
      <view class="info-card">
        <view class="card-header">
          <text class="card-title">时间安排</text>
        </view>
        <view class="info-grid">
          <view class="info-item">
            <text class="info-label">上课时间</text>
            <text class="info-value">{{courseDetail.time}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">上课周次</text>
            <text class="info-value">{{courseDetail.weeks}}</text>
          </view>
        </view>
      </view>

      <!-- 学分信息卡片 -->
      <view class="info-card">
        <view class="card-header">
          <text class="card-title">学分信息</text>
        </view>
        <view class="info-grid">
          <view class="info-item">
            <text class="info-label">学分</text>
            <text class="info-value">{{courseDetail.credit}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">总学时</text>
            <text class="info-value">{{courseDetail.total_hours}}</text>
          </view>
        </view>
      </view>

      <!-- 额外信息（如果有冲突） -->
      <view class="info-card" wx:if="{{courseDetail.isConflict}}">
        <view class="card-header conflict-header">
          <text class="card-title">课程冲突</text>
        </view>
        <view class="conflict-notice">
          <text class="conflict-text">该时间段存在多门课程冲突，可点击课程表中的切换按钮进行切换。</text>
        </view>
      </view>
    </view>

    <!-- 底部操作 -->
    <view class="course-detail-footer">
      <button class="detail-confirm-btn" bindtap="hideCourseDetail">
        <text class="btn-text">确定</text>
      </button>
    </view>
  </view>
</view>