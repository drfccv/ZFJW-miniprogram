/* 课表页面样式 - 统一简约风格 */

/* 页面容器 */
.container {
  height: 100vh;
  background-color: #f8f9fa;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-top: 8rpx;
  padding-bottom: 16rpx;
  box-sizing: border-box;
}

/* 当前周次显示 */
.current-week-display {
  background: #ffffff;
  margin: 16rpx 16rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.current-week-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
}

.swipe-hint {
  font-size: 22rpx;
  color: #adb5bd;
  margin-top: 8rpx;
  display: block;
}

/* 课表包装器 */
.schedule-wrapper {
  flex: 1;
  overflow: hidden;
  padding: 16rpx 16rpx 16rpx 16rpx; /* 上下左右间距一致 */
  display: flex;
  flex-direction: column;
}

/* 课表容器 */
.schedule-container {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100%;
}

/* 表头 */
.schedule-header {
  display: flex;
  background: #f8f9fa;
  border-bottom: 1rpx solid #eef0f2;
  position: sticky;
  top: 0;
  z-index: 10;
  width: 100%;
  align-items: stretch;
}

.time-column-header {
  width: 80rpx;
  min-width: 80rpx;
  max-width: 80rpx;
  flex-shrink: 0;
  padding: 16rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f9fa;
  border-right: 1rpx solid #eef0f2;
  box-sizing: border-box;
}

.time-header-text {
  font-size: 20rpx;
  color: #adb5bd;
  font-weight: 500;
}

.day-header {
  flex: 1;
  min-width: 0;
  width: 0;
  padding: 16rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #eef0f2;
  background: #f8f9fa;
  box-sizing: border-box;
}

.day-header:last-child {
  border-right: none;
}

.day-name {
  font-size: 26rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 4rpx;
  text-align: center;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.day-date {
  color: #adb5bd;
  font-size: 20rpx;
  text-align: center;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

/* 课表内容 */
.schedule-body {
  background: #ffffff;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.schedule-row {
  display: flex;
  border-bottom: 1rpx solid #f0f2f5;
  align-items: stretch;
  width: 100%;
  flex: 1;
  min-height: 80rpx;
}

.schedule-row:last-child {
  border-bottom: none;
}

/* 时间列 */
.time-column {
  width: 80rpx;
  min-width: 80rpx;
  max-width: 80rpx;
  flex-shrink: 0;
  border-right: 1rpx solid #e9ecef;
  background: #f8f9fa;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  box-sizing: border-box;
  height: 100%;
}

.time-period {
  font-size: 22rpx;
  font-weight: 600;
  color: #6c757d;
}

/* 日期列 */
.day-column {
  flex: 1;
  min-width: 0;
  width: 0;
  border-right: 1rpx solid #f0f2f5;
  box-sizing: border-box;
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.day-column:last-child {
  border-right: none;
}

/* 课程单元格 */
.course-cell {
  height: 100%;
  width: 100%;
  min-height: 80rpx; /* 设置最小高度，确保有足够空间显示文字 */
  padding: 8rpx 4rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  transition: all 0.2s ease;
  position: relative;
  background: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
  transition: opacity 0.25s;
}

/* 课程单元格容器（支持多课程） */
.course-cell-container {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.course-cell.has-course {
  position: absolute;
  top: 0;
  left: -2rpx;
  right: 0;
  bottom: 0;
  border-radius: 10rpx;
  border: 1rpx solid;
  min-height: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  box-sizing: border-box;
  overflow: visible;
}

.course-cell.has-course:active {
  filter: brightness(0.96);
}

/* 不同课程的配色（浅色底 + 同色系边框，保证文字对比度）
   使用双类选择器确保覆盖 .course-cell 的白色背景
   共 10 套，色相差异大，尽量降低同色概率 */
.course-cell.course-color-0 { background: #EDF5FF; border-color: #cfe4ff; }
.course-cell.course-color-1 { background: #FFF3E8; border-color: #ffe0c2; }
.course-cell.course-color-2 { background: #F3F0FF; border-color: #e0d8ff; }
.course-cell.course-color-3 { background: #EFFBF4; border-color: #d4f0de; }
.course-cell.course-color-4 { background: #FFF0F2; border-color: #ffd3d8; }
.course-cell.course-color-5 { background: #F0FAF9; border-color: #d2efec; }
.course-cell.course-color-6 { background: #FFF9E5; border-color: #feefc0; }
.course-cell.course-color-7 { background: #EFF8FF; border-color: #d0ecff; }
.course-cell.course-color-8 { background: #F5F5F7; border-color: #e4e4e8; }
.course-cell.course-color-9 { background: #FFF6F0; border-color: #fbe3d5; }

/* 冲突课程样式：在原有配色基础上叠加红色指示 */
.course-cell.conflict-course {
  border-color: #ffb3b3;
  border-style: dashed;
}

.course-cell.merged-course {
  position: absolute;
  top: 0;
  left: -2rpx;
  right: 0;
  z-index: 5;
}

.course-cell.empty-cell {
  background: transparent;
}

.course-cell.placeholder-cell {
  background: transparent;
  border: none;
  margin: 0;
}

.course-cell.fade-out {
  opacity: 0;
}

.course-cell.fade-in {
  opacity: 1;
}

/* 课程内容容器 */
.course-content {
  width: 100%;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  padding: 4rpx 2rpx;
  overflow: hidden;
  box-sizing: border-box;
  gap: 2rpx; /* 添加间距防止文字重叠 */
  position: relative; /* 为绝对定位的切换按钮提供定位基准 */
}

/* 课程内容 */
.course-name {
  font-size: 20rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 0; /* 移除底部边距，使用gap代替 */
  line-height: 1.35;
  overflow: hidden;
  word-wrap: break-word;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  max-height: 54rpx; /* 增加高度，足够显示2行文字 */
  text-align: center;
  width: 100%;
  flex-shrink: 0;
}

/* 不同配色的课程名：同色系深色标题，保证对比度 */
.course-cell.course-color-0 .course-name { color: #1a66cc; }
.course-cell.course-color-1 .course-name { color: #c2680a; }
.course-cell.course-color-2 .course-name { color: #6a4fd8; }
.course-cell.course-color-3 .course-name { color: #1f9d4d; }
.course-cell.course-color-4 .course-name { color: #d14156; }
.course-cell.course-color-5 .course-name { color: #0f9e97; }
.course-cell.course-color-6 .course-name { color: #b5971f; }
.course-cell.course-color-7 .course-name { color: #1f8fd6; }
.course-cell.course-color-8 .course-name { color: #555555; }
.course-cell.course-color-9 .course-name { color: #d17b3f; }

.course-location {
  font-size: 16rpx;
  color: #8a8a8a;
  margin-bottom: 0; /* 移除底部边距，使用gap代替 */
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  text-align: center;
  width: 100%;
  flex-shrink: 0;
}

.course-teacher {
  font-size: 16rpx;
  color: #a0a0a0;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  width: 100%;
  flex-shrink: 0;
}

/* 冲突指示器 */
.conflict-indicator {
  font-size: 12rpx;
  color: #ff5252;
  background: rgba(255, 82, 82, 0.1);
  border: 1rpx solid #ffb3b3;
  border-radius: 6rpx;
  padding: 2rpx 6rpx;
  margin-top: 2rpx;
  text-align: center;
  font-weight: 600;
  flex-shrink: 0;
}

/* 冲突课程切换按钮 */
.conflict-switch-btn {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #ff5252;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(255, 82, 82, 0.3);
  z-index: 10;
}

.conflict-switch-btn:active {
  background: #e53935;
}

.conflict-count {
  font-size: 12rpx;
  color: #ffffff;
  font-weight: 600;
  white-space: nowrap;
}

/* 针对连堂课的特殊处理 */
.course-cell.merged-course .course-content {
  justify-content: center; /* 连堂课有更多空间，可以居中显示 */
  gap: 4rpx; /* 连堂课间隙可以稍大 */
}

.course-cell.merged-course .course-name {
  -webkit-line-clamp: 3; /* 连堂课可以显示更多行 */
  max-height: 72rpx; /* 对应3行的高度 */
}

/* 空状态 */
.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  background: #ffffff;
  margin: 0; /* 移除margin，减少间距 */
  border-radius: 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon-img {
  width: 110rpx;
  height: 110rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #757575;
  margin-bottom: 32rpx;
  font-weight: 500;
}

.reload-btn {
  background: #007AFF;
  color: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  border: none;
  font-weight: 600;
}

.reload-btn:active {
  background: #0066d6;
}

/* 加载状态 */
.loading-state {
  padding: 80rpx 40rpx;
  text-align: center;
  background: #ffffff;
  margin: 0; /* 移除margin，减少间距 */
  border-radius: 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-icon-img {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 20rpx;
  animation: loading-spin 1s linear infinite;
}

@keyframes loading-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #757575;
  font-weight: 500;
}

/* 动画效果 */
@keyframes loading-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.loading-text {
  animation: loading-pulse 2s ease-in-out infinite;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .time-column-header,
  .time-column {
    width: 60rpx;
    min-width: 60rpx;
    max-width: 60rpx;
  }
  
  .day-header {
    padding: 12rpx 2rpx;
  }
  
  .time-header-text {
    font-size: 18rpx;
  }
  
  .time-period {
    font-size: 18rpx;
  }
  .course-name {
    font-size: 16rpx;
    -webkit-line-clamp: 2;
    max-height: 44rpx; /* 调整小屏幕的课程名称高度 */
    line-height: 1.4;
  }
  
  .course-location,
  .course-teacher {
    font-size: 14rpx;
    line-height: 1.3;
  }
  
  .day-name {
    font-size: 18rpx;
  }
  
  .day-date {
    font-size: 16rpx;
  }
  
  .course-cell {
    padding: 6rpx 2rpx;
    min-height: 70rpx; /* 小屏幕下的最小高度 */
  }
  
  .course-cell.has-course {
    margin: 0.5rpx;
  }
}

/* 确保表格不会水平溢出 */
.schedule-header,
.schedule-row {
  width: 100%;
  max-width: 100%;
}

/* 确保所有列均分剩余空间 */
.schedule-header {
  display: flex;
  align-items: stretch;
}

.schedule-row {
  display: flex;
  align-items: stretch;
}

/* 防止flexbox收缩导致的列宽不一致 */
.day-header:nth-child(2),
.day-column:nth-child(2) { flex: 1 1 0; }
.day-header:nth-child(3),
.day-column:nth-child(3) { flex: 1 1 0; }
.day-header:nth-child(4),
.day-column:nth-child(4) { flex: 1 1 0; }
.day-header:nth-child(5),
.day-column:nth-child(5) { flex: 1 1 0; }
.day-header:nth-child(6),
.day-column:nth-child(6) { flex: 1 1 0; }
.day-header:nth-child(7),
.day-column:nth-child(7) { flex: 1 1 0; }
.day-header:nth-child(8),
.day-column:nth-child(8) { flex: 1 1 0; }

/* 课程详情弹窗（底部抽屉式） */
.course-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.course-detail-modal.show {
  opacity: 1;
}

.course-detail-content {
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  width: 100%;
  max-height: 82vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.25s ease;
}

.course-detail-modal.show .course-detail-content {
  transform: translateY(0);
}

.course-detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 40rpx 32rpx 24rpx 32rpx;
  background: #ffffff;
  position: relative;
}

/* 拖拽指示条 */
.drag-handle {
  position: absolute;
  top: 12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e0e0e0;
}

.header-left {
  flex: 1;
  margin-right: 24rpx;
  margin-top: 20rpx;
}

.course-detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.course-detail-subtitle {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

.header-right {
  display: flex;
  align-items: center;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  background: #f2f3f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.close-btn:active {
  background: #e4e5e8;
  transform: scale(0.9);
}

.close-icon {
  font-size: 26rpx;
  color: #666666;
  font-weight: 400;
}

.course-detail-body {
  flex: 1;
  padding: 16rpx 32rpx 32rpx 32rpx;
  overflow-y: auto;
  background: #ffffff;
}

/* 信息卡片 */
.info-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 1rpx solid #f0f2f5;
}

.info-card:last-child {
  margin-bottom: 0;
}

.card-header {
  padding: 20rpx 28rpx 14rpx 28rpx;
  border-bottom: 1rpx solid #f7f8fa;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.conflict-header {
  background: #fff5f5;
}

.conflict-header .card-title {
  color: #ff5252;
}

.info-grid {
  padding: 4rpx 28rpx 12rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.info-item + .info-item {
  border-top: 1rpx solid #f7f8fa;
}

.info-label {
  font-size: 28rpx;
  color: #999999;
  flex-shrink: 0;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  text-align: right;
  margin-left: 24rpx;
  word-wrap: break-word;
  word-break: break-all;
  line-height: 1.4;
  flex: 1;
}

/* 冲突提示 */
.conflict-notice {
  padding: 20rpx 28rpx 24rpx 28rpx;
}

.conflict-text {
  font-size: 24rpx;
  color: #ff6b6b;
  line-height: 1.5;
  background: #fff5f5;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
}

.course-detail-footer {
  padding: 20rpx 32rpx 40rpx 32rpx;
  background: #ffffff;
  border-top: 1rpx solid #f7f8fa;
}

.detail-confirm-btn {
  width: 100%;
  background: #007AFF;
  color: #ffffff;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.detail-confirm-btn:active {
  background: #0066d6;
}

.btn-text {
  color: #ffffff;
}

.slide-left {
  animation: slideLeft 0.3s;
}
.slide-right {
  animation: slideRight 0.3s;
}
@keyframes slideLeft {
  from { transform: translateX(100%); opacity: 0.5; }
  to   { transform: translateX(0); opacity: 1; }
}
@keyframes slideRight {
  from { transform: translateX(-100%); opacity: 0.5; }
  to   { transform: translateX(0); opacity: 1; }
}

.slide-out-left {
  animation: slideOutLeft 0.25s forwards;
}
.slide-in-left {
  animation: slideInLeft 0.25s forwards;
}
.slide-out-right {
  animation: slideOutRight 0.25s forwards;
}
.slide-in-right {
  animation: slideInRight 0.25s forwards;
}
@keyframes slideOutLeft {
  from { transform: translateX(0); opacity: 1; }
  to   { transform: translateX(-100%); opacity: 0.5; }
}
@keyframes slideInLeft {
  from { transform: translateX(100%); opacity: 0.5; }
  to   { transform: translateX(0); opacity: 1; }
}
@keyframes slideOutRight {
  from { transform: translateX(0); opacity: 1; }
  to   { transform: translateX(100%); opacity: 0.5; }
}
@keyframes slideInRight {
  from { transform: translateX(-100%); opacity: 0.5; }
  to   { transform: translateX(0); opacity: 1; }
}