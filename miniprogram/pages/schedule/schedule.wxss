/* 课表页面样式 - 统一简约风格 */

/* 页面容器 */
.container {
  height: calc(100vh - 100rpx); /* 减少预留空间，让底部间距与上部平衡 */
  background-color: #f8f9fa;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding-top: 20rpx;
  padding-bottom: 20rpx; /* 与顶部一致，底部距离更近 */
  box-sizing: border-box;
}

/* 当前周次显示 */
.current-week-display {
  background: #f8f9fa; /* 改为与整体背景一致 */
  padding: 20rpx 24rpx; /* 减少垂直padding */
  text-align: center;
  border-bottom: 1rpx solid #e8ecef;
}

.current-week-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333; /* 改为深灰色，更协调 */
  display: block;
}

.swipe-hint {
  font-size: 22rpx;
  color: #6c757d;
  margin-top: 8rpx;
  display: block;
}

/* 课表包装器 */
.schedule-wrapper {
  flex: 1;
  overflow: hidden;
  padding: 20rpx 16rpx 20rpx 16rpx; /* 上下左右间距一致 */
}

.week-item:not(.active):active {
  background: #e9ecef;
  transform: scale(0.95);
}

/* 课表容器 */
.schedule-container {
  background: #ffffff;
  border-radius: 20rpx; /* 统一使用大圆角 */
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100%;
}

/* 表头 */
.schedule-header {
  display: flex;
  background: #f8f9fa;
  border-bottom: 2rpx solid #e9ecef;
  position: sticky;
  top: 0;
  z-index: 10;
  width: 100%;
  align-items: stretch;
}

.time-column-header {
  width: 80rpx;
  min-width: 80rpx;
  max-width: 80rpx;
  flex-shrink: 0;
  padding: 16rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border-right: 1rpx solid #e9ecef;
  box-sizing: border-box;
}

.time-header-text {
  font-size: 22rpx;
  color: #6c757d;
  font-weight: 600;
}

.day-header {
  flex: 1;
  min-width: 0;
  width: 0;
  padding: 16rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #e9ecef;
  background: #ffffff;
  box-sizing: border-box;
}

.day-header:last-child {
  border-right: none;
}

.day-name {
  font-size: 24rpx;
  color: #343a40;
  font-weight: 600;
  margin-bottom: 4rpx;
  text-align: center;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.day-date {
  color: #666;
  font-size: 20rpx;
  text-align: center;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

/* 课表内容 */
.schedule-body {
  background: #ffffff;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.schedule-row {
  display: flex;
  border-bottom: 1rpx solid #f0f2f5;
  align-items: stretch;
  width: 100%;
}

.schedule-row:last-child {
  border-bottom: none;
}

/* 时间列 */
.time-column {
  width: 80rpx;
  min-width: 80rpx;
  max-width: 80rpx;
  flex-shrink: 0;
  border-right: 1rpx solid #e9ecef;
  background: #f8f9fa;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx;
  box-sizing: border-box;
  height: 100%;
}

.time-period {
  font-size: 22rpx;
  font-weight: 600;
  color: #6c757d;
}

/* 日期列 */
.day-column {
  flex: 1;
  min-width: 0;
  width: 0;
  border-right: 1rpx solid #f0f2f5;
  box-sizing: border-box;
  position: relative;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.day-column:last-child {
  border-right: none;
}

/* 课程单元格 */
.course-cell {
  height: 100%;
  width: 100%;
  min-height: 80rpx; /* 设置最小高度，确保有足够空间显示文字 */
  padding: 8rpx 4rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  transition: all 0.2s ease;
  position: relative;
  background: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
  transition: opacity 0.25s;
}

/* 课程单元格容器（支持多课程） */
.course-cell-container {
  height: 100%;
  width: 100%;
  position: relative;
}

.course-cell.has-course {
  background: linear-gradient(to bottom right, #e3f2fd, #f3e5f5);
  border-radius: 8rpx; /* 统一为小圆角 */
  margin: 1rpx;
  border: 1rpx solid #e1f5fe;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  min-height: inherit; /* 继承父元素的最小高度 */
}

.course-cell.has-course:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* 冲突课程样式 */
.course-cell.conflict-course {
  background: linear-gradient(to bottom right, #ffebee, #fce4ec);
  border: 1rpx solid #f8bbd9;
  box-shadow: 0 2rpx 8rpx rgba(233, 30, 99, 0.1);
}

.course-cell.conflict-course:active {
  background: linear-gradient(to bottom right, #ffcdd2, #f8bbd9);
}

.course-cell.merged-course {
  position: absolute;
  top: 1rpx;
  left: 1rpx;
  right: 1rpx;
  z-index: 5;
  background: linear-gradient(to bottom right, #e8f5e8, #fff3e0);
  border-color: #c8e6c9;
}

.course-cell.empty-cell {
  background: transparent;
}

.course-cell.placeholder-cell {
  background: transparent;
  border: none;
  margin: 0;
}

.course-cell.fade-out {
  opacity: 0;
}

.course-cell.fade-in {
  opacity: 1;
}

/* 课程内容容器 */
.course-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  padding: 4rpx 2rpx;
  overflow: hidden;
  box-sizing: border-box;
  gap: 2rpx; /* 添加间距防止文字重叠 */
  position: relative; /* 为绝对定位的切换按钮提供定位基准 */
}

/* 课程内容 */
.course-name {
  font-size: 18rpx;
  font-weight: 600;
  color: #1976d2;
  margin-bottom: 0; /* 移除底部边距，使用gap代替 */
  line-height: 1.3;
  overflow: hidden;
  word-wrap: break-word;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  max-height: 48rpx; /* 增加高度，足够显示2行文字 */
  text-align: center;
  width: 100%;
  flex-shrink: 0;
}

.course-location {
  font-size: 14rpx;
  color: #757575;
  margin-bottom: 0; /* 移除底部边距，使用gap代替 */
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  width: 100%;
  flex-shrink: 0;
}

.course-teacher {
  font-size: 14rpx;
  color: #9e9e9e;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  width: 100%;
  flex-shrink: 0;
}

/* 冲突指示器 */
.conflict-indicator {
  font-size: 12rpx;
  color: #e91e63;
  background: rgba(233, 30, 99, 0.1);
  border: 1rpx solid #e91e63;
  border-radius: 4rpx;
  padding: 2rpx 6rpx;
  margin-top: 2rpx;
  text-align: center;
  font-weight: 600;
  flex-shrink: 0;
}

/* 冲突课程切换按钮 */
.conflict-switch-btn {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #e91e63, #f06292);
  border-radius: 50% 50% 50% 0; /* 创建斜三角形效果 */
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(233, 30, 99, 0.3);
  transform: rotate(45deg); /* 旋转45度形成右下角三角形 */
  z-index: 10;
}

.conflict-switch-btn:active {
  transform: rotate(45deg) scale(0.9);
  background: linear-gradient(135deg, #c2185b, #e91e63);
}

.conflict-count {
  font-size: 10rpx;
  color: white;
  font-weight: 600;
  transform: rotate(-45deg); /* 反向旋转文字，保持水平 */
  white-space: nowrap;
}

/* 针对连堂课的特殊处理 */
.course-cell.merged-course .course-content {
  justify-content: center; /* 连堂课有更多空间，可以居中显示 */
  gap: 4rpx; /* 连堂课间隙可以稍大 */
}

.course-cell.merged-course .course-name {
  -webkit-line-clamp: 3; /* 连堂课可以显示更多行 */
  max-height: 72rpx; /* 对应3行的高度 */
}

/* 空状态 */
.empty-state {
  padding: 80rpx 40rpx;
  text-align: center;
  background: #ffffff;
  margin: 0; /* 移除margin，减少间距 */
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 72rpx;
  color: #bdbdbd;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #757575;
  margin-bottom: 32rpx;
  font-weight: 500;
}

.reload-btn {
  background: #007bff;
  color: #ffffff;
  padding: 16rpx 32rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 123, 255, 0.25);
  font-weight: 600;
}

.reload-btn:active {
  background: #0056b3;
  transform: scale(0.98);
}

/* 加载状态 */
.loading-state {
  padding: 80rpx 40rpx;
  text-align: center;
  background: #ffffff;
  margin: 0; /* 移除margin，减少间距 */
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-text {
  font-size: 28rpx;
  color: #757575;
  font-weight: 500;
}

/* 动画效果 */
@keyframes loading-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.loading-text {
  animation: loading-pulse 2s ease-in-out infinite;
}

/* 响应式适配 */
@media (max-width: 400px) {
  .time-column-header,
  .time-column {
    width: 60rpx;
    min-width: 60rpx;
    max-width: 60rpx;
  }
  
  .day-header {
    padding: 12rpx 2rpx;
  }
  
  .time-header-text {
    font-size: 18rpx;
  }
  
  .time-period {
    font-size: 18rpx;
  }
  .course-name {
    font-size: 14rpx;
    -webkit-line-clamp: 2;
    max-height: 40rpx; /* 调整小屏幕的课程名称高度 */
    line-height: 1.4;
  }
  
  .course-location,
  .course-teacher {
    font-size: 12rpx;
    line-height: 1.3;
  }
  
  .day-name {
    font-size: 18rpx;
  }
  
  .day-date {
    font-size: 16rpx;
  }
  
  .course-cell {
    padding: 6rpx 2rpx;
    min-height: 70rpx; /* 小屏幕下的最小高度 */
  }
  
  .course-cell.has-course {
    margin: 0.5rpx;
  }
}

/* 确保表格不会水平溢出 */
.schedule-header,
.schedule-row {
  width: 100%;
  max-width: 100%;
}

/* 确保所有列均分剩余空间 */
.schedule-header {
  display: flex;
  align-items: stretch;
}

.schedule-row {
  display: flex;
  align-items: stretch;
}

/* 防止flexbox收缩导致的列宽不一致 */
.day-header:nth-child(2),
.day-column:nth-child(2) { flex: 1 1 0; }
.day-header:nth-child(3),
.day-column:nth-child(3) { flex: 1 1 0; }
.day-header:nth-child(4),
.day-column:nth-child(4) { flex: 1 1 0; }
.day-header:nth-child(5),
.day-column:nth-child(5) { flex: 1 1 0; }
.day-header:nth-child(6),
.day-column:nth-child(6) { flex: 1 1 0; }
.day-header:nth-child(7),
.day-column:nth-child(7) { flex: 1 1 0; }
.day-header:nth-child(8),
.day-column:nth-child(8) { flex: 1 1 0; }

/* 课程详情弹窗 */
.course-detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 40rpx;
  box-sizing: border-box;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.course-detail-modal.show {
  opacity: 1;
}

.course-detail-content {
  background: #ffffff;
  border-radius: 24rpx;
  width: 100%;
  max-width: 640rpx;
  max-height: 85vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.course-detail-modal.show .course-detail-content {
  transform: scale(1);
}

.course-detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 36rpx 32rpx 28rpx 32rpx;
  background: linear-gradient(to bottom right, #007AFF, #5AC8FA);
  color: white;
  border-radius: 24rpx 24rpx 0 0;
  position: relative;
  overflow: hidden;
}

.course-detail-header::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
  transform: translate(50%, -50%);
}

.header-left {
  flex: 1;
  margin-right: 24rpx;
}

.course-detail-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.course-detail-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

.header-right {
  display: flex;
  align-items: center;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  z-index: 1;
}

.close-btn:active {
  background: rgba(255, 255, 255, 0.4);
  transform: scale(0.9);
}

.close-icon {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

.course-detail-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
  background: #f8f9fa;
}

/* 信息卡片 */
.info-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: none;
}

.info-card:last-child {
  margin-bottom: 0;
}

.card-header {
  padding: 24rpx 32rpx 16rpx 32rpx;
  border-bottom: 1rpx solid #f0f2f5;
  background: linear-gradient(to right, #f8f9fa, #ffffff);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.conflict-header {
  background: linear-gradient(90deg, #fff5f5, #ffeaea);
}

.conflict-header .card-title {
  color: #e74c3c;
}

.info-grid {
  padding: 24rpx 32rpx 32rpx 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 200rpx;
}

.info-item.full-width {
  flex: 1 1 100%;
}

.info-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.teacher-icon {
  background: linear-gradient(135deg, #007AFF, #5AC8FA);
}

.location-icon {
  background: linear-gradient(135deg, #34C759, #30D158);
}

.time-icon {
  background: linear-gradient(135deg, #007AFF, #00C7BE);
}

.week-icon {
  background: linear-gradient(135deg, #5AC8FA, #00D4FF);
}

.credit-icon {
  background: linear-gradient(135deg, #FF9500, #FFCC00);
}

.hours-icon {
  background: linear-gradient(135deg, #AF52DE, #BF5AF2);
}

.info-content {
  flex: 1;
  min-width: 0;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
  font-weight: 500;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  word-wrap: break-word;
  word-break: break-all;
  line-height: 1.4;
}

.info-value.highlight {
  color: #007AFF;
  font-weight: 700;
  font-size: 32rpx;
}

/* 冲突提示 */
.conflict-notice {
  padding: 24rpx 32rpx 32rpx 32rpx;
}

.conflict-text {
  font-size: 26rpx;
  color: #e74c3c;
  line-height: 1.5;
  background: #fef2f2;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border-left: 4rpx solid #e74c3c;
}

.course-detail-footer {
  padding: 24rpx 32rpx 32rpx 32rpx;
  background: #ffffff;
  border-top: 1rpx solid #f0f2f5;
}

.detail-confirm-btn {
  width: 100%;
  background: linear-gradient(to bottom right, #007AFF, #5AC8FA);
  color: #ffffff;
  border: none;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(0, 122, 255, 0.3);
  transition: all 0.3s ease;
}

.detail-confirm-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 15rpx rgba(0, 122, 255, 0.4);
}

.btn-text {
  color: #ffffff;
}

.slide-left {
  animation: slideLeft 0.3s;
}
.slide-right {
  animation: slideRight 0.3s;
}
@keyframes slideLeft {
  from { transform: translateX(100%); opacity: 0.5; }
  to   { transform: translateX(0); opacity: 1; }
}
@keyframes slideRight {
  from { transform: translateX(-100%); opacity: 0.5; }
  to   { transform: translateX(0); opacity: 1; }
}

.slide-out-left {
  animation: slideOutLeft 0.25s forwards;
}
.slide-in-left {
  animation: slideInLeft 0.25s forwards;
}
.slide-out-right {
  animation: slideOutRight 0.25s forwards;
}
.slide-in-right {
  animation: slideInRight 0.25s forwards;
}
@keyframes slideOutLeft {
  from { transform: translateX(0); opacity: 1; }
  to   { transform: translateX(-100%); opacity: 0.5; }
}
@keyframes slideInLeft {
  from { transform: translateX(100%); opacity: 0.5; }
  to   { transform: translateX(0); opacity: 1; }
}
@keyframes slideOutRight {
  from { transform: translateX(0); opacity: 1; }
  to   { transform: translateX(100%); opacity: 0.5; }
}
@keyframes slideInRight {
  from { transform: translateX(-100%); opacity: 0.5; }
  to   { transform: translateX(0); opacity: 1; }
}